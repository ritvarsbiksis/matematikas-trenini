# Copy this file to `.env.local` and fill in the values for your Supabase project.
#
#   cp .env.example .env.local
#
# Hosted project: Dashboard -> Project Settings -> API
# Local dev:      run `pnpm db:start` and use the URL / anon key it prints.

# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

#SUPABASE_ACCESS_TOKEN=your-access-token-here

# --- Social sign-in (local development only) --------------------------------
#
# These are read by the Supabase CLI, not by Next.js, to fill in the `env(...)`
# placeholders in `supabase/config.toml`. Put them in `.env` at the repo root
# (gitignored) rather than `.env.local`, and flip the matching `enabled` flag in
# `config.toml`. A hosted project configures providers in the Dashboard and
# needs none of this.
#
# Register each OAuth app with the callback URL http://127.0.0.1:54321/auth/v1/callback
#
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
# SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=
